  "bugs": {
    "url": "https://github.com/dsprag/usb/issues"
  },
  "homepage": "https://github.com/dsprag/usb#readme",
  "dependencies": {
    "axios": "^1.12.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
