{
  "name": "workspace",
  "version": "1.0.0",
  "description": "E-commerce order management dashboards (admin and operator) with workflow steps and Shopify sync.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "sync:shopify": "node -e \"(async()=>{const {connect}=require('./src/db');const {DB_PATH}=require('./src/config');const {syncShopifyOnce}=require('./src/services/shopify');const db=connect(DB_PATH);const res=await syncShopifyOnce(db);console.log(res);})().catch(e=>{console.error(e);process.exit(1);})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsprag/usb.git"
  },
  "keywords": [],
